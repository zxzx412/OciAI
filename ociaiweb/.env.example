# OciAI 环境变量配置
# 复制此文件为 .env 并修改相应配置

# ====================
# 数据库配置（Docker 自动使用）
# ====================
DB_USER=ociai
DB_PASSWORD=ociai_secret_2024
DB_NAME=ociai
DB_PORT=5432

# ====================
# 服务配置
# ====================
SERVER_PORT=8080

# ====================
# 全局配置
# ====================
GLOBAL_MAX_CONCURRENCY=100
QUEUE_SIZE=1000
REQUEST_TIMEOUT=60s
RETRY_ATTEMPTS=2
LOAD_BALANCE_STRATEGY=round_robin

# ====================
# 流式响应配置
# ====================
FORCE_NON_STREAM=false
USE_SIMULATED_STREAM=true
DEFAULT_MAX_TOKENS=4000